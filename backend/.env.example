# Groq API Key (Get a free key at https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Model Selection (openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.6-27b)
# Run `curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"`
# to see your current available models — Groq periodically retires older ones.
MODEL_NAME=openai/gpt-oss-120b
